			"item": [
				{
					"name": "Admin Login",
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test.admin@egoola.com\",\n  \"password\": \"Test@12345\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/admin/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"admin",
								"login",
								""
							]
						},
						"description": "Public endpoint \u2014 no token needed. Returns access + refresh JWTs carrying actor_type=admin. Every Buyer Management endpoint below is Admin-only."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('access_token', body.access);",
									"    pm.collectionVariables.set('refresh_token', body.refresh);",
									"    console.log('Saved admin access/refresh tokens.');",
									"}",
									"pm.test('Status is 200', () => pm.response.to.have.status(200));"
								]
							}
						}
					]
				}
			]
		},
