    {
      "name": "Email Templates",
      "item": [
        {
          "name": "Create Email Template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"demo_order_approved_{{$timestamp}}\",\n  \"subject\": \"Your Egoola order has been approved\",\n  \"content\": \"Hi {{buyerName}}, your order #{{orderId}} has been approved.\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/cms/email-templates/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "cms",
                "email-templates",
                ""
              ]
            },
            "description": "`key` is the stable id application code looks the template up by: lowercase letters, digits and underscores, starting with a letter, unique, and **cannot be changed later**. `content` may contain `{{variables}}`. `is_active` (default true) controls whether the app actually sends it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('template_id', pm.response.json().id); pm.collectionVariables.set('template_key', pm.response.json().key); }",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
