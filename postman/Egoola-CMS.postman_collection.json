{
  "info": {
    "name": "Egoola API — CMS & Site Settings",
    "description": "Admin-side content management: Banners, Email Templates, Site Settings and the Site Logo.\n\nAll endpoints need an Admin token. Lists are paginated (limit/offset).\n\nHow to use:\n1. Pick the `Egoola - Local` environment (or edit `base_url`).\n2. Run **Auth > Admin Login**.\n3. Run the folders top to bottom. Requests that upload an image (banners, site logo) need a real file chosen in the Postman app — they can't run under Newman.\n4. `category_id` must be an existing product category in your database.\n\nSee docs/cms-api-guide.md for every payload and error case.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "18",
      "type": "string"
    },
    {
      "key": "banner_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "sidebar_banner_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "template_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "template_key",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.admin@egoola.com\",\n  \"password\": \"Test@12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/admin/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "admin",
                "login",
                ""
              ]
            },
            "description": "Public endpoint — no token needed. Returns access + refresh JWTs carrying actor_type=admin. Every CMS endpoint below needs an Admin token (a plain admin is enough)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', body.access);",
                  "    pm.collectionVariables.set('refresh_token', body.refresh);",
                  "    console.log('Saved admin access/refresh tokens.');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Exchanges the saved refresh token (14-day life) for a new access token (1-hour life). Run this instead of logging in again once the access token expires."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', body.access);",
                  "    console.log('Refreshed access_token.');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Banners",
      "item": [
        {
          "name": "Create Banner — hero",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "placement",
                  "value": "hero",
                  "type": "text"
                },
                {
                  "key": "heading",
                  "value": "Eid Collection is Here {{$timestamp}}",
                  "type": "text"
                },
                {
                  "key": "small_heading",
                  "value": "Up to 40% off",
                  "type": "text"
                },
                {
                  "key": "link_url",
                  "value": "/categories/electronics",
                  "type": "text"
                },
                {
                  "key": "sort_order",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "active",
                  "type": "text"
                },
                {
                  "key": "starts_at",
                  "value": "2026-08-01T00:00:00Z",
                  "type": "text"
                },
                {
                  "key": "ends_at",
                  "value": "2999-08-31T23:59:59Z",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/cms/banners/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "cms",
                "banners",
                ""
              ]
            },
            "description": "Multipart form data. Required: `placement` (hero | sidebar | category) and `image`. Optional: heading, small_heading, link_url, status (active default | inactive), sort_order, starts_at / ends_at (ISO datetimes, ends_at must be after starts_at), category (sidebar only). **Choose a real image file in the Postman app** — a shared collection can't carry file paths, so under Newman/CLI this request is skipped-by-failure (400)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('banner_id', pm.response.json().id); }",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('image stored', () => pm.expect(pm.response.json().image_url).to.be.a('string').and.not.empty);",
                  "pm.test('active by default', () => pm.expect(pm.response.json().status).to.eql('active'));"
                ]
              }
            }
          ]
        },
