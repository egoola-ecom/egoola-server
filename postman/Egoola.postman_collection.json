        {
          "name": "Buyers",
          "item": [
            {
              "name": "List Buyers",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/accounts/buyers/?search=&status=&country=&state=&city=&thana=&email_verified=&phone_verified=&created_from=&created_to=",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "accounts",
                    "buyers",
                    ""
                  ],
                  "query": [
                    {
                      "key": "search",
                      "value": "",
                      "description": "name, email or phone"
                    },
                    {
                      "key": "status",
                      "value": "",
                      "description": "active | suspended"
                    },
                    {
                      "key": "country",
                      "value": "",
                      "description": "country id"
                    },
                    {
                      "key": "state",
                      "value": "",
                      "description": "state id"
                    },
                    {
                      "key": "city",
                      "value": "",
                      "description": "city id"
                    },
                    {
                      "key": "thana",
                      "value": "",
                      "description": "thana id"
                    },
                    {
                      "key": "email_verified",
                      "value": "",
                      "description": "true | false"
                    },
                    {
                      "key": "phone_verified",
                      "value": "",
                      "description": "true | false"
                    },
                    {
                      "key": "created_from",
                      "value": "",
                      "description": "signup date from, YYYY-MM-DD (inclusive)"
                    },
                    {
                      "key": "created_to",
                      "value": "",
                      "description": "signup date to, YYYY-MM-DD (inclusive)"
                    }
                  ]
                },
                "description": "Admin-only. Light rows (no media). Filters: search, status, country, state, city, thana, email_verified, phone_verified, created_from, created_to \u2014 combine freely. Paginated with limit/offset. Full detail (media, address, skills) is on Retrieve Buyer. See docs/buyer-management-guide.md."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
