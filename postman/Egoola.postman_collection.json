                  "    console.log('Saved seller access token as seller_token (not used by Accounts requests below \u2014 those need an admin token).');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
