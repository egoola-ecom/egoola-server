{
  "info": {
    "name": "Egoola API — Accounts & Auth",
    "_postman_id": "6f1e6a6a-2b3d-4f6a-9c9a-egoola-accounts-auth",
    "description": "Covers what's built so far: Admin/Seller/Buyer login (JWT) + token refresh, and Admin-only Admin/Seller/Buyer management.\n\nHow to use:\n1. Pick the `Egoola - Local` environment (or edit `base_url`).\n2. Run any request in **Auth** first — its \"Tests\" script saves the returned `access`/`refresh` tokens into collection variables automatically.\n3. Every request under **Accounts** already sends `Authorization: Bearer {{access_token}}` — no manual copy-pasting needed.\n4. When a 401 says the token expired, run **Auth > Refresh Token** — it re-saves `access_token` the same way.\n\nAll accounts endpoints require an Admin token (401 = no/invalid token, 403 = valid token but wrong role — see docs/authentication.md in the repo).\n\nFor Country/State/City/Thana reference-data management, see the separate Egoola API — Geography collection. For the full Seller Verification workflow (verify/reject with a mandatory note, verification_logs history) and deeper Seller-only coverage (business info, media upload), see the separate Egoola API — Seller collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "seller_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyer_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.admin@egoola.com\",\n  \"password\": \"Test@12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/admin/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "admin",
                "login",
                ""
              ]
            },
            "description": "Public endpoint — no token needed to call this. Returns access + refresh JWTs carrying actor_type=admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', body.access);",
                  "    pm.collectionVariables.set('refresh_token', body.refresh);",
                  "    pm.collectionVariables.set('admin_id', body.id);",
                  "    console.log('Saved admin access/refresh tokens.');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Seller Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.seller@egoola.com\",\n  \"password\": \"Test@12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/seller/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "seller",
                "login",
                ""
              ]
            },
            "description": "Public endpoint. Returns a token carrying actor_type=seller — will get 403 on every Accounts endpoint below (those are Admin-only), which is expected until Seller self-service routes exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('seller_token', body.access);",
                  "    console.log('Saved seller access token as seller_token (not used by Accounts requests below — those need an admin token).');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Buyer Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.buyer@egoola.com\",\n  \"password\": \"Test@12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/buyer/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "buyer",
                "login",
                ""
              ]
            },
            "description": "Public endpoint. Returns a token carrying actor_type=user (buyer)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('buyer_token', body.access);",
                  "    console.log('Saved buyer access token as buyer_token (not used by Accounts requests below — those need an admin token).');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Exchanges the saved refresh token (14-day life) for a new access token (1-hour life) — the actor_type/actor_id claims carry over automatically. Run this instead of logging in again once the access token expires."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', body.access);",
                  "    console.log('Refreshed access_token.');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
