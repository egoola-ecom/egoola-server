        {
          "name": "Admins",
          "item": [
            {
              "name": "List Admins",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/accounts/admins/?search=&type=&status=",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "accounts",
                    "admins",
                    ""
                  ],
                  "query": [
                    {
                      "key": "search",
                      "value": "",
                      "description": "matches name, email, mobile"
                    },
                    {
                      "key": "type",
                      "value": "",
                      "description": "super_admin | admin | moderator | support"
                    },
                    {
                      "key": "status",
                      "value": "",
                      "description": "active | inactive"
                    }
                  ]
                },
                "description": "Admin-only. Returns the list-view fields (no media, no full geography — see AdminListSerializer)."
              }
            },
            {
              "name": "Create Admin",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"New Admin\",\n  \"email\": \"new.admin@egoola.com\",\n  \"mobile\": \"01700000010\",\n  \"password\": \"Test@12345\",\n  \"type\": \"admin\",\n  \"status\": \"active\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/accounts/admins/",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "accounts",
                    "admins",
                    ""
                  ]
                },
                "description": "`password` is required on create (hashed server-side), optional on update. `type` choices: super_admin, admin, moderator, support."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) { pm.collectionVariables.set('admin_id', pm.response.json().id); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Retrieve Admin",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/accounts/admins/{{admin_id}}/",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "accounts",
                    "admins",
                    "{{admin_id}}",
                    ""
                  ]
                },
                "description": "Full detail view — includes media[] and geography fields, unlike the list view."
              }
            },
            {
              "name": "Update Admin (full — PUT)",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"New Admin (Updated)\",\n  \"email\": \"new.admin@egoola.com\",\n  \"mobile\": \"01700000010\",\n  \"type\": \"admin\",\n  \"status\": \"active\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/accounts/admins/{{admin_id}}/",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "accounts",
                    "admins",
                    "{{admin_id}}",
                    ""
                  ]
                },
                "description": "PUT replaces the whole record — `password` can be left out on update (only re-hashed if you send a new one)."
              }
            },
            {
              "name": "Update Admin (partial — PATCH)",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"inactive\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/accounts/admins/{{admin_id}}/",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "accounts",
                    "admins",
                    "{{admin_id}}",
                    ""
                  ]
                },
                "description": "Preferred for small edits — only send the field(s) you're changing."
              }
            },
            {
              "name": "Delete Admin",
              "request": {
                "method": "DELETE",
                "url": {
                  "raw": "{{base_url}}/api/v1/accounts/admins/{{admin_id}}/",
                  "host": [
