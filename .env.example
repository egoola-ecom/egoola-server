# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real secrets.

# Signs Django's own sessions/CSRF tokens AND every JWT this project issues
# (see SIMPLE_JWT["SIGNING_KEY"] in settings.py) — never leave this as the
# placeholder below, and never reuse one value across dev/staging/prod.
# Generate a real one per environment with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dhaka

# local (every developer's machine, the default) uses a local folder as a
# stand-in bucket (MEDIA_ROOT below); anything else uses the real S3 bucket
# (the AWS_* variables below) — see config/storage.py.
DJANGO_ENV=local

# Local PostgreSQL connection (Phase 0 Backend, task 3)
DB_NAME=egoola
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# egoola-web's dev origin, for CORS (Phase 0 Backend, task 6)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3 bucket — only read/used when DJANGO_ENV is not "local".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Local "bucket" stand-in folder — only read/used when DJANGO_ENV=local.
# Leave blank to use ./media in the project folder, or point it at any
# folder on your own machine — this is per developer, never committed.
MEDIA_ROOT=
